{
  "manifest_version": 3,
  "name": "Flow Autopilot",
  "version": "0.1.0",
  "description": "Automate ChatGPT product analysis -> ChatGPT image-gen storyboard -> Google Flow (Veo) video, using your own logged-in browser sessions. 100% client-side, no server, no shared credentials.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "src/lib/messages.js",
        "src/lib/selectors.js",
        "src/lib/dom-utils.js",
        "src/content/content-chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": [
        "src/lib/messages.js",
        "src/lib/selectors.js",
        "src/lib/dom-utils.js",
        "src/content/content-flow.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
